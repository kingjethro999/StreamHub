# Copy this file to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Database (Docker Postgres — see docker-compose.yml) --------------------
# `docker-compose up -d` reads POSTGRES_* to create the container, and the API
# connects using DATABASE_URL. Keep the three values in sync.
# If port 5432 is already in use on your machine, change POSTGRES_PORT and the
# port inside DATABASE_URL to a free one (e.g. 5434).
POSTGRES_USER=streamhub
POSTGRES_PASSWORD=streamhub
POSTGRES_DB=streamhub
POSTGRES_PORT=5432
DATABASE_URL=postgres://streamhub:streamhub@localhost:5432/streamhub

# Set to true when DATABASE_URL points at a managed Postgres that requires TLS.
DATABASE_SSL=false

# --- Auth -------------------------------------------------------------------
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Email (follower "going live" notifications) ----------------------------
# Leave SMTP_USER/SMTP_PASS empty to disable emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StreamHub Alerts <no-reply@example.com>

# --- Frontend (bundled into the client — never put secrets here) ------------
VITE_API_BASE_URL=/api
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# --- Cloudinary server-side credentials (optional, currently unused) --------
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- NVIDIA hosted API (server-side only — never put secrets in VITE_ vars) --
# Get a key from build.nvidia.com. Leave empty to disable AI features;
# the platform remains fully functional without it.
# API base for NVIDIA hosted inference (OpenAI-compatible /v1/chat/completions).
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
# Your NVIDIA API key. Required only for AI video understanding / generation.
NVIDIA_API_KEY=

# NVIDIA model used for video understanding (summaries, captions, "ask this
# video"). Leave as default unless you want to point at a different model.
NVIDIA_VIDEO_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

{
  "name": "streamhub-react",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node api.js && concurrently -k -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite dev",
    "build": "node api.js && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "start": "node api.js && node server/index.js",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "db:setup": "node server/db/migrate.js && node server/db/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.4",
    "@fastify/static": "^10.1.6",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "lucide-react": "^1.58.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.30",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
